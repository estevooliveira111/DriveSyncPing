<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DriveSyncPing.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        x:Class="DriveSyncPing.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Icon="/Assets/avalonia-logo.ico"
        Title="DriveSyncPing"
        Width="900" Height="680"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="DriveSyncPing" FontSize="28" FontWeight="Bold" Foreground="#89b4fa"/>
                <TextBlock Text="Sincronize pastas locais com o Google Drive facilmente." FontSize="14" Foreground="#a6adc8"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding GoogleDriveStatus}" VerticalAlignment="Center" FontSize="12" Foreground="#f9e2af"/>
                <Button Command="{Binding LoginGoogleCommand}" IsVisible="{Binding !IsConnected}" Background="#89b4fa" Foreground="#11111b" FontWeight="Bold">Conectar</Button>
                <Button Command="{Binding LogoutGoogleCommand}" IsVisible="{Binding IsConnected}" Background="#f38ba8" Foreground="#11111b" FontWeight="Bold">Desconectar</Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <!-- ================= PASTAS ================= -->
            <TabItem Header="Pastas">
                <Border Background="#181825" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                            <TextBlock Text="Pastas Configuradas" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="18"/>
                            <Button Grid.Column="1" Command="{Binding AddFolderCommand}" Background="#a6e3a1" Foreground="#11111b" FontWeight="Bold" CornerRadius="4">
                                + Adicionar Pasta
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" Background="Transparent" Margin="0,0,0,15">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding Path}" FontWeight="Medium"/>
                                            <TextBlock Text="Ativa" Foreground="#a6e3a1" FontSize="12" IsVisible="{Binding IsEnabled}"/>
                                            <TextBlock Text="Inativa" Foreground="#f38ba8" FontSize="12" IsVisible="{Binding !IsEnabled}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="Regra:" VerticalAlignment="Center" FontSize="12" Foreground="#a6adc8"/>
                                            <ComboBox SelectedItem="{Binding OrganizationRule, Mode=TwoWay}"
                                                      ItemsSource="{Binding #Root.((vm:MainViewModel)DataContext).AvailableRules}"
                                                      Width="140"
                                                      Background="#313244"
                                                      Foreground="#cdd6f4"
                                                      CornerRadius="4"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}" Background="#f38ba8" Foreground="#11111b" CornerRadius="4">
                                            Remover
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Action / Sync area -->
                        <Border Grid.Row="2" Background="#11111b" Padding="15" CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <Button Grid.Column="0" Command="{Binding RunSyncCommand}"
                                            IsEnabled="{Binding IsConnected}"
                                            Background="#89b4fa" Foreground="#11111b" FontWeight="Bold" FontSize="16" Padding="15,10">
                                        Sincronizar Agora
                                    </Button>

                                    <Button Grid.Column="1" Command="{Binding CancelSyncCommand}"
                                            IsVisible="{Binding IsSyncing}"
                                            Margin="10,0,0,0"
                                            Background="#f38ba8" Foreground="#11111b" FontWeight="Bold" FontSize="16" Padding="15,10">
                                        Cancelar
                                    </Button>

                                    <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SyncStatusText}" FontSize="12" Foreground="#cdd6f4" Margin="0,0,0,5"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SyncProgress}" Height="8" Background="#313244" Foreground="#a6e3a1"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <CheckBox IsChecked="{Binding DryRun}" Content="Modo simulação (dry-run)" Foreground="#cdd6f4"/>
                                    <CheckBox IsChecked="{Binding DeleteAfterUpload}" Content="Excluir local após upload validado" Foreground="#cdd6f4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= HISTÓRICO ================= -->
            <TabItem Header="Histórico">
                <Border Background="#181825" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="320,*">
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBlock Text="Execuções" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding LoadHistoryCommand}" Background="#313244" Foreground="#cdd6f4" CornerRadius="4">Atualizar</Button>
                        </Grid>

                        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedJob}" Background="Transparent" Margin="0,0,10,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd/MM HH:mm}'}" FontWeight="Medium"/>
                                        <TextBlock FontSize="11" Foreground="#a6adc8"
                                                   Text="{Binding Status}"/>
                                        <TextBlock FontSize="11" Foreground="#89b4fa">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Enviados {0} · Duplicados {1} · Falhas {2} · Excluídos {3}">
                                                    <Binding Path="FilesUploaded"/>
                                                    <Binding Path="FilesIgnored"/>
                                                    <Binding Path="FilesFailed"/>
                                                    <Binding Path="FilesDeleted"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="dry-run" FontSize="10" Foreground="#f9e2af" IsVisible="{Binding IsDryRun}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedJobOperations}" Background="#11111b">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,150,*" Margin="0,2">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="#a6adc8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Foreground="#89b4fa"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= ERROS ================= -->
            <TabItem Header="Erros">
                <Border Background="#181825" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Erros e falhas de validação recentes" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding LastErrors}" Background="#11111b">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="150,150,*" Margin="0,2">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm:ss}'}" FontSize="11" Foreground="#a6adc8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Foreground="#f9e2af"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" Foreground="#f38ba8" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ================= CONFIGURAÇÕES ================= -->
            <TabItem Header="Configurações">
                <Border Background="#181825" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                    <StackPanel Spacing="18" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Regras de upload e exclusão" FontWeight="SemiBold" FontSize="18"/>
                        <CheckBox IsChecked="{Binding DeleteAfterUpload}" Content="Excluir arquivos locais somente após o upload ser validado" Foreground="#cdd6f4"/>
                        <CheckBox IsChecked="{Binding DryRun}" Content="Iniciar sincronizações em modo simulação (dry-run) por padrão" Foreground="#cdd6f4"/>

                        <Separator Background="#313244"/>

                        <TextBlock Text="Agendamento automático" FontWeight="SemiBold" FontSize="18"/>
                        <CheckBox IsChecked="{Binding ScheduleEnabled}" Content="Executar sincronização automaticamente" Foreground="#cdd6f4"/>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Horário (HH:mm):" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ScheduleTime}" Width="80" Background="#313244" Foreground="#cdd6f4"/>
                        </StackPanel>

                        <TextBlock Text="Dias da semana:" Foreground="#a6adc8"/>
                        <WrapPanel>
                            <CheckBox IsChecked="{Binding DayMonday}" Content="Seg" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DayTuesday}" Content="Ter" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DayWednesday}" Content="Qua" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DayThursday}" Content="Qui" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DayFriday}" Content="Sex" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DaySaturday}" Content="Sáb" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                            <CheckBox IsChecked="{Binding DaySunday}" Content="Dom" Margin="0,0,12,0" Foreground="#cdd6f4"/>
                        </WrapPanel>

                        <Button Command="{Binding SaveSettingsCommand}" Background="#a6e3a1" Foreground="#11111b" FontWeight="Bold" CornerRadius="4" HorizontalAlignment="Left" Padding="16,8">
                            Salvar configurações
                        </Button>
                        <TextBlock Text="{Binding SettingsStatus}" Foreground="#a6e3a1" FontSize="12"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="© DriveSyncPing 2026" Foreground="#6c7086" Margin="0,15,0,0" FontSize="12" HorizontalAlignment="Center"/>
    </Grid>
</Window>
